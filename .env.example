# ============================================================
# SGTI Municipal — Variables de entorno DEMO (sin credenciales reales)
# Copia este archivo como .env y ajusta los valores locales
# ============================================================

# Entorno
NODE_ENV=development
PORT=3001

# JWT — usa cualquier cadena larga aleatoria (NO la de producción)
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_larga_local
JWT_EXPIRES_IN=24h

# Base de datos local (MySQL corriendo en tu máquina)
DB_UNIFIED_HOST=127.0.0.1
DB_UNIFIED_PORT=3306
DB_UNIFIED_NAME=sgti_demo
DB_UNIFIED_USER=root
DB_UNIFIED_PASS=tu_password_mysql_local

# WhatsApp — desactivado en entorno local
DISABLE_WHATSAPP=true

# OpenAI — desactivado en entorno local (dejar vacío)
OPENAI_API_KEY=
